@model AxciomCRM.ViewModels.CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    <a asp-action="Create" class="btn btn-primary">Add Customer</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search name, email, phone or company" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Company</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var customer in Model.Customers)
    {
        <tr>
            <td>@customer.CustomerCode</td>
            <td>@customer.CustomerName</td>
            <td>@customer.Email</td>
            <td>@customer.Phone</td>
            <td>@customer.CompanyName</td>
            <td>@customer.Status</td>
            <td>
                <a asp-action="Details" asp-route-id="@customer.CustomerId">Details</a> |
                <a asp-action="Edit" asp-route-id="@customer.CustomerId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@customer.CustomerId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
        @for (var number = 1; number <= Model.TotalPages; number++)
        {
            <li class="page-item @(number == Model.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@number">@number</a>
            </li>
        }
        </ul>
    </nav>
}
