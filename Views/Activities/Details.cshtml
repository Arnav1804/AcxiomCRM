@model AxciomCRM.Models.Activity
@{ ViewData["Title"] = "Activity Details"; }
<h1>Activity Details</h1>
<dl class="row"><dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.ActivityType</dd><dt class="col-sm-3">Subject</dt><dd class="col-sm-9">@Model.Subject</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd><dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.ActivityDate</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl>
<a asp-action="Index" class="btn btn-secondary">Back</a>
