@model AxciomCRM.ViewModels.ActivityListViewModel
@{ ViewData["Title"] = "Activities"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Activities</h1><a asp-action="Create" class="btn btn-primary">Add Activity</a></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-2"><select name="type" class="form-select"><option value="">All types</option>@foreach (var item in AppConstants.ActivityTypes) { <option value="@item" selected="@(Model.Type == item)">@item</option> }</select></div>
    <div class="col-md-2"><input type="date" name="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in AppConstants.ActivityStatuses) { <option value="@item" selected="@(Model.Status == item)">@item</option> }</select></div>
    <div class="col-md-3"><select name="assignedUser" class="form-select"><option value="">All users</option>@foreach (var user in Model.Users) { <option value="@user.Id" selected="@(Model.AssignedUser == user.Id)">@user.FullName</option> }</select></div>
    <div class="col-md-3"><button class="btn btn-outline-primary" type="submit">Search</button> <a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
</form>
<table class="table table-bordered table-hover"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th><th>Assigned To</th><th></th></tr></thead><tbody>
@foreach (var activity in Model.Activities)
{
    var user = Model.Users.FirstOrDefault(u => u.Id == activity.AssignedTo);
    <tr><td>@activity.ActivityDate.ToShortDateString()</td><td>@activity.ActivityType</td><td>@activity.Subject</td><td>@activity.Status</td><td>@(user?.FullName ?? activity.AssignedTo)</td><td><a asp-action="Details" asp-route-id="@activity.ActivityId">Details</a></td></tr>
}
</tbody></table>
@if (Model.TotalPages > 1) { <nav><ul class="pagination">@for (var number = 1; number <= Model.TotalPages; number++) { <li class="page-item @(number == Model.Page ? "active" : "")"><a class="page-link" asp-route-type="@Model.Type" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" asp-route-assignedUser="@Model.AssignedUser" asp-route-page="@number">@number</a></li> }</ul></nav> }
