@model List<AxciomCRM.ViewModels.RoleCountViewModel>
@{ ViewData["Title"] = "Roles"; }
<h1>Roles</h1>
<table class="table table-bordered"><thead><tr><th>Role</th><th>User Count</th></tr></thead><tbody>@foreach (var role in Model) { <tr><td>@role.Role</td><td>@role.UserCount</td></tr> }</tbody></table>
