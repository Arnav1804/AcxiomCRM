@model AxciomCRM.ViewModels.OpportunityListViewModel
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-3"><h1>Opportunities</h1><div><a asp-action="Pipeline" class="btn btn-outline-primary">Sales Pipeline</a> <a asp-action="Create" class="btn btn-primary">Add Opportunity</a></div></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="name" value="@Model.Name" class="form-control" placeholder="Opportunity name" /></div>
    <div class="col-md-2"><select name="customerId" class="form-select"><option value="">All customers</option>@foreach (var customer in Model.Customers) { <option value="@customer.CustomerId" selected="@(Model.CustomerId == customer.CustomerId)">@customer.CustomerName</option> }</select></div>
    <div class="col-md-2"><select name="stage" class="form-select"><option value="">All stages</option>@foreach (var item in AppConstants.OpportunityStages) { <option value="@item" selected="@(Model.Stage == item)">@item</option> }</select></div>
    <div class="col-md-2"><select name="status" class="form-select"><option value="">All statuses</option><option value="Open" selected="@(Model.Status == "Open")">Open</option><option value="Won" selected="@(Model.Status == "Won")">Won</option><option value="Lost" selected="@(Model.Status == "Lost")">Lost</option></select></div>
    <div class="col-md-3"><button type="submit" class="btn btn-outline-primary">Search</button> <a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
</form>
<table class="table table-bordered table-hover"><thead><tr><th>Name</th><th>Customer</th><th>Amount</th><th>Stage</th><th>Probability</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var opportunity in Model.Opportunities)
{
    var customer = Model.Customers.FirstOrDefault(c => c.CustomerId == opportunity.CustomerId);
    <tr><td>@opportunity.OpportunityName</td><td>@(customer?.CustomerName ?? "-")</td><td>@opportunity.Amount</td><td>@opportunity.Stage</td><td>@opportunity.Probability%</td><td>@opportunity.Status</td><td><a asp-action="Details" asp-route-id="@opportunity.OpportunityId">Details</a> | <a asp-action="Edit" asp-route-id="@opportunity.OpportunityId">Edit</a> | <a asp-action="Delete" asp-route-id="@opportunity.OpportunityId">Delete</a></td></tr>
}
</tbody></table>
@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination">@for (var number = 1; number <= Model.TotalPages; number++) { <li class="page-item @(number == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-name="@Model.Name" asp-route-customerId="@Model.CustomerId" asp-route-stage="@Model.Stage" asp-route-status="@Model.Status" asp-route-page="@number">@number</a></li> }</ul></nav>
}
