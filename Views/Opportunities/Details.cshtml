@model AxciomCRM.Models.Opportunity
@{ ViewData["Title"] = "Opportunity Details"; var customer = ViewBag.Customer as Customer; }
<h1>Opportunity Details</h1>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.OpportunityName</dd>
    <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@customer?.CustomerName</dd>
    <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount</dd>
    <dt class="col-sm-3">Stage</dt><dd class="col-sm-9">@Model.Stage</dd>
    <dt class="col-sm-3">Probability</dt><dd class="col-sm-9">@Model.Probability%</dd>
    <dt class="col-sm-3">Expected Close Date</dt><dd class="col-sm-9">@Model.ExpectedCloseDate.ToShortDateString()</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-secondary">Back</a>
