@model AxciomCRM.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Leads</h1>
    <a asp-action="Create" class="btn btn-primary">Add Lead</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="name" value="@Model.Name" class="form-control" placeholder="Lead name" /></div>
    <div class="col-md-3"><input name="company" value="@Model.Company" class="form-control" placeholder="Company" /></div>
    <div class="col-md-2">
        <select name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in AppConstants.LeadStatuses) { <option value="@item" selected="@(Model.Status == item)">@item</option> }</select>
    </div>
    <div class="col-md-2">
        <select name="assignedUser" class="form-select"><option value="">All assigned users</option>@foreach (var user in Model.SalesUsers) { <option value="@user.Id" selected="@(Model.AssignedUser == user.Id)">@user.FullName</option> }</select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-outline-primary">Search</button> <a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
</form>

<table class="table table-bordered table-hover">
    <thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Status</th><th>Expected Value</th><th>Assigned To</th><th></th></tr></thead>
    <tbody>
    @foreach (var lead in Model.Leads)
    {
        var user = Model.SalesUsers.FirstOrDefault(u => u.Id == lead.AssignedTo);
        <tr>
            <td>@lead.LeadCode</td><td>@lead.LeadName</td><td>@lead.CompanyName</td><td>@lead.Status</td><td>@lead.ExpectedValue</td><td>@(user?.FullName ?? lead.AssignedTo)</td>
            <td><a asp-action="Details" asp-route-id="@lead.LeadId">Details</a> | <a asp-action="Edit" asp-route-id="@lead.LeadId">Edit</a> | <a asp-action="Delete" asp-route-id="@lead.LeadId">Delete</a></td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination">@for (var number = 1; number <= Model.TotalPages; number++) { <li class="page-item @(number == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-name="@Model.Name" asp-route-company="@Model.Company" asp-route-status="@Model.Status" asp-route-assignedUser="@Model.AssignedUser" asp-route-page="@number">@number</a></li> }</ul></nav>
}
